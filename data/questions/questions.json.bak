      "questionNumber": 18
    },
    "rawQuestion": "En un triángulo rectángulo ABC recto en B, se traza la altura BH relativa a la hipotenusa. Si las proyecciones de los catetos sobre la hipotenusa son AH = 4 cm y HC = 9 cm, ¿cuál es la longitud de la altura BH?",
    "options": [
      { "id": "A", "text": "5 cm" },
      { "id": "B", "text": "6 cm" },
      { "id": "C", "text": "6.5 cm" },
      { "id": "D", "text": "7 cm" },
      { "id": "E", "text": "8 cm" }
    ],
    "correctAnswer": "B",
    "explanation": {
      "solutionStepByStep": [
        "Paso 1: Aplicar el teorema de la altura relativa a la hipotenusa: h² = m * n.",
        "Paso 2: Aquí m = AH = 4 cm y n = HC = 9 cm.",
        "Paso 3: BH² = 4 * 9 = 36  =>  BH = √36 = 6 cm."
      ],
      "keyConcept": "El cuadrado de la altura a la hipotenusa es igual al producto de las proyecciones de los catetos.",
      "quickTip": "Media proporcional directa: BH = √(4 * 9) = 6.",
      "commonPitfall": "Sumar las proyecciones (4+9=13) y dividir entre dos creyendo que es la altura."
    },
    "relatedFichaId": "FICHA-MAT-PORCENTAJES",
    "status": "VALIDATED"
  },
