    "rawQuestion": "Tres campanarios tocan sus campanas cada 6, 8 y 12 minutos respectivamente. Si tocan simultáneamente a las 8:00 a.m., ¿a qué hora volverán a coincidir por primera vez?",
    "options": [
      { "id": "A", "text": "8:18 a.m." },
      { "id": "B", "text": "8:24 a.m." },
      { "id": "C", "text": "8:36 a.m." },
      { "id": "D", "text": "8:48 a.m." },
      { "id": "E", "text": "9:00 a.m." }
    ],
    "correctAnswer": "B",
    "explanation": {
      "solutionStepByStep": [
        "Paso 1: El tiempo en el que vuelven a coincidir corresponde al Mínimo Común Múltiplo (MCM).",
        "Paso 2: Calculamos MCM(6, 8, 12). Descomposición: 6 = 2*3, 8 = 2³, 12 = 2²*3.",
        "Paso 3: MCM = 2³ * 3 = 8 * 3 = 24 minutos.",
        "Paso 4: Hora final: 8:00 a.m. + 24 min = 8:24 a.m."
      ],
      "keyConcept": "Problemas de sincronización y coincidencias periódicas se resuelven con el MCM.",
      "quickTip": "Como 12 es múltiplo de 6, solo calcula MCM(8, 12) = 24.",
      "commonPitfall": "Calcular el MCD (que es 2 minutos) en lugar del MCM."
    },
    "relatedFichaId": "FICHA-MAT-PORCENTAJES",
    "status": "VALIDATED"
  }
