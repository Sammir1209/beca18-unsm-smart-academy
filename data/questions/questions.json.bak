    "rawQuestion": "Determine el término que continúa en la siguiente progresión aritmética: 7, 13, 19, 25, 31, ... ¿Cuál es el término de lugar 20?",
    "options": [
      { "id": "A", "text": "115" },
      { "id": "B", "text": "121" },
      { "id": "C", "text": "127" },
      { "id": "D", "text": "119" },
      { "id": "E", "text": "125" }
    ],
    "correctAnswer": "B",
    "explanation": {
      "solutionStepByStep": [
        "Paso 1: Identificar razón r = 13 - 7 = 6. Término primero t1 = 7.",
        "Paso 2: Fórmula del término enésimo: tn = t1 + (n - 1) * r.",
        "Paso 3: Para n = 20: t20 = 7 + (20 - 1) * 6 = 7 + 19 * 6 = 7 + 114 = 121."
      ],
      "keyConcept": "En una P.A.: tn = t1 + (n - 1)r.",
      "quickTip": "tn = 6n + 1 (ya que 6(1) + 1 = 7). Por ende, para n=20: 6(20) + 1 = 121.",
      "commonPitfall": "Multiplicar 20 * 6 directamente sin ajustar el término cero o el (n-1)."
    },
    "relatedFichaId": "FICHA-MAT-PORCENTAJES",
    "status": "VALIDATED"
  },
