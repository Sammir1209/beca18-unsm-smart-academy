    "rawQuestion": "Un bloque de 60 N de peso descansa sobre una superficie horizontal lisa. Si se le aplica una fuerza horizontal F constante de 30 N hacia la derecha, determine el valor de la fuerza normal ejercida por el piso sobre el bloque.",
    "options": [
      { "id": "A", "text": "30 N" },
      { "id": "B", "text": "60 N" },
      { "id": "C", "text": "90 N" },
      { "id": "D", "text": "45 N" },
      { "id": "E", "text": "0 N" }
    ],
    "correctAnswer": "B",
    "explanation": {
      "solutionStepByStep": [
        "Paso 1: Realizar el Diagrama de Cuerpo Libre (DCL) en el eje vertical.",
        "Paso 2: En el eje Y no hay movimiento (equilibrio vertical): ΣFy = 0.",
        "Paso 3: Normal (hacia arriba) - Peso (hacia abajo) = 0  =>  N = Peso = 60 N.",
        "Paso 4: La fuerza horizontal F solo influye en la aceleración en el eje X, no altera la normal sobre plano horizontal."
      ],
      "keyConcept": "En una superficie horizontal sin componentes verticales de fuerza externa, Normal = Peso.",
      "quickTip": "No combines fuerzas perpendiculares entre sí en la condición de equilibrio.",
      "commonPitfall": "Sumar 60 + 30 = 90 N confundiendo los ejes X e Y."
    },
    "relatedFichaId": "FICHA-FIS-CINEMATICA-MRUV",
    "status": "VALIDATED"
  },
