    "rawQuestion": "Para un átomo neutro cuyo número atómico es Z = 17 (Cloro), ¿cuántos electrones de valencia posee en su último nivel de energía?",
    "options": [
      { "id": "A", "text": "5" },
      { "id": "B", "text": "7" },
      { "id": "C", "text": "8" },
      { "id": "D", "text": "3" },
      { "id": "E", "text": "1" }
    ],
    "correctAnswer": "B",
    "explanation": {
      "solutionStepByStep": [
        "Paso 1: Realizar la configuración electrónica de Z = 17: 1s² 2s² 2p⁶ 3s² 3p⁵.",
        "Paso 2: Identificar el último nivel de energía (n = 3).",
        "Paso 3: Sumar los electrones en dicho nivel: subnivel 3s tiene 2 e⁻, subnivel 3p tiene 5 e⁻.",
        "Paso 4: Electrones de valencia = 2 + 5 = 7 electrones (Grupo VIIA / Halógenos)."
      ],
      "keyConcept": "Los electrones de valencia corresponden a los electrones del nivel de mayor energía n.",
      "quickTip": "Regla del gas noble: [10Ne] 3s² 3p⁵ => 2 + 5 = 7 electrones.",
      "commonPitfall": "Contar solo los electrones del último subnivel (3p⁵ = 5) olvidando los del 3s²."
    },
    "relatedFichaId": "FICHA-FIS-CINEMATICA-MRUV",
    "status": "VALIDATED"
  },
